# Copy this file to .env and fill in your real key.
# .env should NOT be committed to version control.

GROQ_API_KEY=gsk_your_real_key_here

# Model used unless a request specifies its own "model" field.
DEFAULT_MODEL=openai/gpt-oss-120b

# Comma-separated list of origins allowed to call this API.
# Use "*" during local development; lock this down in production.
ALLOWED_ORIGINS=*

# Timeouts, in seconds.
TOPICS_TIMEOUT_SECONDS=45
QUESTIONS_TIMEOUT_SECONDS=60
